# RO_DOMAIN: the public domain (e.g. office.example.com). Caddy gets and renews the HTTPS certificate.
# RO_BACKEND: where the API runs inside the Docker network.
{$RO_DOMAIN:localhost} {
	encode zstd gzip

	# API and uploads go to Spring Boot (uploads up to 50 MB per file)
	handle /api/* {
		request_body {
			max_size 120MB
		}
		reverse_proxy {$RO_BACKEND:backend:8090}
	}

	# Never expose internals publicly
	handle /actuator/* {
		respond 404
	}

	# Angular app: hashed assets cached long, index.html never cached, SPA fallback
	handle {
		root * /srv
		@assets path *.js *.css *.woff2 *.png *.svg *.ico *.webp
		header @assets Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
